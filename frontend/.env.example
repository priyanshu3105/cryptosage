# Real API authentication is the default (signup/login hit the backend).
# Set to true only for offline UI demos without a running API:
VITE_DEMO_AUTH=false

# Dev: Vite proxies /api → http://127.0.0.1:<PORT> where PORT is read from ../backend/.env
# If port 4000 is already in use, set PORT=4001 (or any free port) in backend/.env and restart
# both the API and the Vite dev server.

# Optional: only if you are not using the Vite dev proxy (e.g. production build against API)
# VITE_API_BASE_URL=http://127.0.0.1:4000/api
